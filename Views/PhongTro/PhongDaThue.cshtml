@model IEnumerable<Do_an_co_so.Models.HoaDon>

@{
    ViewData["Title"] = "Phòng Trọ Đã Thuê";
}

<div class="container mt-4 mb-5">
    <div class="mb-4">
        <h2 class="text-success fw-bold">🏡 Lịch sử thuê phòng của bạn</h2>
        <p class="text-muted">Danh sách các phòng bạn đã thanh toán thành công qua VNPay.</p>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm border-0 rounded-4 h-100 overflow-hidden">
                        <div class="row g-0 h-100">
                            <!-- Cột hình ảnh -->
                            <div class="col-4">
                                @{
                                    string img = "/images/no-image.jpg";
                                    if (item.PhongTro != null && !string.IsNullOrEmpty(item.PhongTro.HinhAnh))
                                    {
                                        img = "/images/" + item.PhongTro.HinhAnh.Split(',')[0];
                                    }
                                }
                                <img src="@img" class="img-fluid w-100 h-100" style="object-fit: cover;" alt="Hình phòng">
                            </div>

                            <!-- Cột thông tin -->
                            <div class="col-8">
                                <div class="card-body d-flex flex-column h-100">
                                    <h5 class="card-title fw-bold text-primary mb-1">
                                        @(item.PhongTro?.DiaChi ?? "Phòng đã bị xóa")
                                    </h5>

                                    <div class="text-danger fw-bold mb-2">
                                        💰 Đã thanh toán: @item.TongTien.ToString("N0") đ
                                    </div>

                                    <div class="text-muted small mb-3">
                                        <i class="bi bi-clock"></i> Ngày thuê: @item.NgayGiaoDich.ToString("dd/MM/yyyy HH:mm")
                                    </div>

                                    <!-- BẢNG THÔNG TIN LIÊN HỆ & THAO TÁC -->
                                    <div class="mt-auto bg-light p-3 rounded-3 border">
                                        <p class="mb-2 fw-bold text-dark small">📞 Thông tin liên hệ nhận phòng:</p>

                                        <div class="mb-3 small text-dark">
                                            <div class="mb-1">
                                                <strong>Chủ trọ:</strong> @(item.PhongTro?.ChuTro?.UserName?.Split('@')[0] ?? "Không rõ")
                                            </div>
                                            <div>
                                                <strong>SĐT:</strong> <span class="text-primary fw-bold fs-6">@(item.PhongTro?.ChuTro?.PhoneNumber ?? "Chưa cập nhật")</span>
                                            </div>
                                        </div>

                                        <!-- CỤM NÚT THAO TÁC MỚI -->
                                        <div class="d-flex gap-2">
                                            <!-- Nút Xem chi tiết & Đánh giá -->
                                            <a asp-action="Details" asp-route-id="@item.PhongTroId" class="btn btn-sm btn-info text-white rounded-pill flex-grow-1 fw-bold">
                                                🔍 Xem & Đánh giá
                                            </a>

                                            <!-- Nút Nhắn tin -->
                                            <a asp-controller="Chat" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill flex-grow-1 fw-bold">
                                                💬 Nhắn tin
                                            </a>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center p-5">
                <h5 class="text-muted">Bạn chưa thuê căn phòng nào.</h5>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3 rounded-pill">Quay lại trang chủ tìm phòng</a>
            </div>
        }
    </div>
</div>