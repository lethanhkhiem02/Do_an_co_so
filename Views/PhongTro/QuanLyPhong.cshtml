@model IEnumerable<Do_an_co_so.Models.PhongTro>

@{
    ViewData["Title"] = "Quản lý phòng của tôi";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">📋 Danh sách phòng bạn đã đăng</h2>
        <a asp-action="Create" class="btn btn-warning fw-bold rounded-pill shadow-sm">✨ Đăng phòng mới</a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-primary text-white">
                    <tr>
                        <th class="ps-4">Hình ảnh</th>
                        <th>Thông tin phòng</th>
                        <th>Giá thuê</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    @{
                                        string img = "/images/no-image.jpg";
                                        if (!string.IsNullOrEmpty(item.HinhAnh)) img = "/images/" + item.HinhAnh.Split(',')[0];
                                    }
                                    <img src="@img" class="rounded-3 shadow-sm" style="width: 100px; height: 70px; object-fit: cover;">
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.DiaChi</div>
                                    <small class="text-muted d-block text-truncate" style="max-width: 250px;">@item.MoTa</small>
                                </td>
                                <td>
                                    <span class="text-danger fw-bold">@item.Gia.ToString("N0") đ</span>
                                </td>
                                <td class="text-center">
                                    @if (item.IsVip)
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm">⭐ TIN VIP</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 py-2 rounded-pill">Tin thường</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <div class="btn-group shadow-sm rounded-pill overflow-hidden">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary px-3">Xem</a>

                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                                              onsubmit="return confirm('Bạn có chắc muốn xóa phòng này?');" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-outline-danger px-3">Xóa</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center p-5 text-muted">
                                <h5>Bạn chưa đăng phòng trọ nào. Hãy bắt đầu ngay! 🚀</h5>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>