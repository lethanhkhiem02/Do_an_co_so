@model Do_an_co_so.Models.PhongTro

@{
    ViewData["Title"] = "Đăng phòng mới";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container mt-4 mb-5">
    <h2 class="text-primary fw-bold mb-4">✨ Điền Thông Tin Phòng Trọ</h2>

    <div class="card card-custom p-4 col-md-8 mx-auto shadow-sm rounded-4">
        <form asp-action="Create" enctype="multipart/form-data" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="MoTa" class="form-label fw-bold"></label>
                <textarea asp-for="MoTa" class="form-control" rows="4" placeholder="Ví dụ: Phòng trọ 25m2, có gác lửng, WC riêng, giờ giấc tự do..."></textarea>
                <span asp-validation-for="MoTa" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Gia" class="form-label fw-bold"></label>
                <input asp-for="Gia" type="number" class="form-control" placeholder="Ví dụ: 2500000" />
                <span asp-validation-for="Gia" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DiaChi" class="form-label fw-bold"></label>
                <div class="input-group">
                    <input asp-for="DiaChi" id="diaChiInput" class="form-control" placeholder="Ví dụ: 475A Điện Biên Phủ, Phường 25, Bình Thạnh, Hồ Chí Minh" />
                    <button class="btn btn-outline-primary fw-bold" type="button" id="btnTimViTri">
                        📍 Tìm trên bản đồ
                    </button>
                </div>
                <span asp-validation-for="DiaChi" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold text-primary">📍 Ghim vị trí trên bản đồ</label>
                <div id="map" style="height: 350px; border-radius: 10px; border: 1px solid #ddd;"></div>
                <small class="text-muted">Bản đồ sẽ tự động di chuyển khi bạn bấm "Tìm trên bản đồ". Bạn cũng có thể kéo dấu ghim để chỉnh lại cho chính xác nhất.</small>

                <input type="hidden" asp-for="Latitude" id="latInput" />
                <input type="hidden" asp-for="Longitude" id="lngInput" />
            </div>

            <div class="mb-4">
                <label asp-for="ImageUploads" class="form-label fw-bold text-success">📷 Thêm hình ảnh (Có thể chọn nhiều)</label>
                <input asp-for="ImageUploads" type="file" class="form-control" accept="image/*" multiple />
                <span asp-validation-for="ImageUploads" class="text-danger"></span>
            </div>

            <div class="mb-4 mt-4">
                <div class="card border-warning shadow-sm" style="border-width: 2px;">
                    <div class="card-body bg-warning bg-opacity-10 rounded">
                        <div class="form-check form-switch fs-5">
                            <input class="form-check-input border-warning" type="checkbox" asp-for="IsVip" id="vipSwitch">
                            <label class="form-check-label fw-bold text-danger" for="vipSwitch" style="cursor: pointer;">
                                ⭐ Đăng tin VIP (Phí: 50.000 VNĐ)
                            </label>
                        </div>
                        <small class="text-muted mt-2 d-block">
                            💡 Tin VIP sẽ được ghim lên đầu bảng kết quả tìm kiếm với thiết kế nổi bật, giúp phòng của bạn tiếp cận sinh viên và chốt khách nhanh gấp 3 lần!
                        </small>
                    </div>
                </div>
            </div>

            <div class="mt-4 text-center">
                <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill fw-bold">Đăng Lên Hệ Thống</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        // 1. Khởi tạo bản đồ mặc định
        var map = L.map('map').setView([10.8018, 106.7115], 14);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap'
        }).addTo(map);

        // 2. Tạo dấu ghim có thể kéo thả
        var marker = L.marker([10.8018, 106.7115], { draggable: true }).addTo(map);

        // 3. Hàm cập nhật tọa độ vào Input ẩn
        function updateLatLng(lat, lng) {
            document.getElementById('latInput').value = lat;
            document.getElementById('lngInput').value = lng;
        }

        // Khởi tạo giá trị mặc định lúc load trang
        updateLatLng(10.8018, 106.7115);

        // Bắt sự kiện khi người dùng kéo thả ghim xong
        marker.on('dragend', function (e) {
            var coords = e.target.getLatLng();
            updateLatLng(coords.lat, coords.lng);
        });

        // Click vào bản đồ để ghim nhảy tới đó nhanh
        map.on('click', function(e) {
            marker.setLatLng(e.latlng);
            updateLatLng(e.latlng.lat, e.latlng.lng);
        });

        // ==========================================
        // 4. TÍNH NĂNG GEOCODING (ĐỊA CHỈ -> TỌA ĐỘ)
        // ==========================================
        document.getElementById('btnTimViTri').addEventListener('click', function () {
            var address = document.getElementById('diaChiInput').value;

            if (!address) {
                alert("Vui lòng nhập địa chỉ trước khi tìm kiếm!");
                return;
            }

            // Gọi API miễn phí của Nominatim (OpenStreetMap)
            var apiUrl = 'https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent(address);

            fetch(apiUrl)
                .then(response => response.json())
                .then(data => {
                    if (data && data.length > 0) {
                        var lat = data[0].lat;
                        var lon = data[0].lon;

                        // Di chuyển bản đồ mượt mà (flyTo) về vị trí mới với zoom level 16
                        map.flyTo([lat, lon], 16);

                        // Cắm lại ghim vào vị trí mới
                        marker.setLatLng([lat, lon]);

                        // Tự động điền tọa độ vào 2 ô input ẩn
                        updateLatLng(lat, lon);
                    } else {
                        alert("Không tìm thấy tọa độ cho địa chỉ này. Bạn vui lòng nhập rõ hơn (Thêm Phường, Quận, Thành phố) hoặc tự ghim tay nhé!");
                    }
                })
                .catch(error => {
                    console.error('Lỗi khi gọi Geocoding API:', error);
                    alert("Có lỗi xảy ra khi tìm vị trí, vui lòng thử lại.");
                });
        });

        // Tự động kích hoạt nút Tìm kiếm nếu người dùng gõ xong và bấm Enter trong ô địa chỉ
        document.getElementById('diaChiInput').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault(); // Ngăn chặn form submit nhầm
                document.getElementById('btnTimViTri').click();
            }
        });
    </script>
}