@model Do_an_co_so.Models.PhongTro
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Do_an_co_so.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["PostNewRoom"];
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container mt-4 mb-5">
    <h2 class="text-primary fw-bold mb-4">✨ @Localizer["FillRoomInfo"]</h2>

    <div class="card card-custom p-4 col-md-8 mx-auto shadow-sm rounded-4">
        <form asp-action="Create" enctype="multipart/form-data" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="MoTa" class="form-label fw-bold"></label>
                <textarea asp-for="MoTa" class="form-control" rows="4" placeholder="@Localizer["RoomDescPlaceholder"]"></textarea>
                <span asp-validation-for="MoTa" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ChieuDai" class="form-label fw-bold"></label>
                    <input asp-for="ChieuDai" type="number" step="0.1" class="form-control" placeholder="@Localizer["LengthPlaceholder"]" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ChieuRong" class="form-label fw-bold"></label>
                    <input asp-for="ChieuRong" type="number" step="0.1" class="form-control" placeholder="@Localizer["WidthPlaceholder"]" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold text-dark">⏳ @Localizer["PostDuration"]</label>
                    <input type="number" name="soNgayDangBai" class="form-control" value="30" min="1" placeholder="Mặc định: 30 ngày" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold text-dark">⏳ @Localizer["HoldDuration"]</label>
                    <input type="number" name="soNgayGiuPhong" class="form-control" value="7" min="1" placeholder="Mặc định: 7 ngày" />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="form-check form-switch fs-5">
                        <input class="form-check-input" type="checkbox" asp-for="CoNhaVeSinh" id="wcSwitch">
                        <label class="form-check-label fw-bold" for="wcSwitch">🚽 @Localizer["HasPrivateWC"]</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-check form-switch fs-5">
                        <input class="form-check-input" type="checkbox" asp-for="CoBanCong" id="banCongSwitch">
                        <label class="form-check-label fw-bold" for="banCongSwitch">🌅 @Localizer["HasBalcony"]</label>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Gia" class="form-label fw-bold">@Localizer["RentPrice"]</label>
                <input asp-for="Gia" type="number" class="form-control" placeholder="@Localizer["PricePlaceholder"]" />
                <span asp-validation-for="Gia" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">@Localizer["DetailedAddress"]</label>
                <div class="row g-2 mb-2">
                    <div class="col-md-4">
                        <select class="form-select" id="cboCity">
                            <option value="" selected>-- @Localizer["SelectProvince"] --</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <select class="form-select" id="cboDistrict" disabled>
                            <option value="" selected>-- @Localizer["SelectDistrict"] --</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <select class="form-select" id="cboWard" disabled>
                            <option value="" selected>-- @Localizer["SelectWard"] --</option>
                        </select>
                    </div>
                </div>
                <div class="row g-2">
                    <div class="col-md-8">
                        <input type="text" class="form-control" id="txtStreet" placeholder="@Localizer["AddressPlaceholder"]">
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-outline-primary w-100 fw-bold" type="button" id="btnTimViTri">
                            📍 @Localizer["FindOnMap"]
                        </button>
                    </div>
                </div>
                <input type="hidden" asp-for="DiaChi" id="HiddenDiaChi" />
                <span asp-validation-for="DiaChi" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-end mb-2">
                    <label class="form-label fw-bold text-primary mb-0">📍 @Localizer["PinOnMap"]</label>

                    <button type="button" id="btnCurrentLocation" class="btn btn-sm btn-info text-white fw-bold shadow-sm rounded-pill">
                        <i class="bi bi-geo-fill"></i> @Localizer["MyLocation"]
                    </button>
                </div>

                <div id="map" style="height: 350px; border-radius: 10px; border: 1px solid #ddd;"></div>
                <small class="text-muted">@Localizer["MapInstruction"]</small>

                <input type="hidden" asp-for="Latitude" id="latInput" />
                <input type="hidden" asp-for="Longitude" id="lngInput" />
            </div>

            <div class="mb-4">
                <label asp-for="ImageUploads" class="form-label fw-bold text-success">📷 @Localizer["AddImages"]</label>
                <input asp-for="ImageUploads" type="file" class="form-control" accept="image/*" multiple />
                <span asp-validation-for="ImageUploads" class="text-danger"></span>
            </div>

            <div class="mb-4 mt-4">
                <div class="card border-warning shadow-sm" style="border-width: 2px;">
                    <div class="card-body bg-warning bg-opacity-10 rounded">
                        <div class="form-check form-switch fs-5">
                            <input class="form-check-input border-warning" type="checkbox" asp-for="IsVip" id="vipSwitch">
                            <label class="form-check-label fw-bold text-danger" for="vipSwitch" style="cursor: pointer;">
                                ⭐ @Localizer["PostVip"]
                            </label>
                        </div>
                        <small class="text-muted mt-2 d-block">
                            💡 @Localizer["VipInstruction"]
                        </small>
                    </div>
                </div>
            </div>

            <div class="mt-4 text-center">
                <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill fw-bold">@Localizer["PublishPost"]</button>
            </div>
        </form>
    </div>
</div>

<input type="hidden" id="langSelectDistrict" value="@Localizer["SelectDistrict"]" />
<input type="hidden" id="langSelectWard" value="@Localizer["SelectWard"]" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        // --- 1. XỬ LÝ MAP ---
        var map = L.map('map').setView([10.8018, 106.7115], 14);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap'
        }).addTo(map);
        var marker = L.marker([10.8018, 106.7115], { draggable: true }).addTo(map);

        // 🔥 BẢN VÁ TỌA ĐỘ: Đổi dấu chấm thành dấu phẩy để C# (.NET) hiểu đúng số thập phân
        function updateLatLng(lat, lng) {
            var latStr = lat.toString().replace('.', ',');
            var lngStr = lng.toString().replace('.', ',');
            document.getElementById('latInput').value = latStr;
            document.getElementById('lngInput').value = lngStr;
        }
        updateLatLng(10.8018, 106.7115);

        marker.on('dragend', function (e) {
            var coords = e.target.getLatLng();
            updateLatLng(coords.lat, coords.lng);
        });

        map.on('click', function(e) {
            marker.setLatLng(e.latlng);
            updateLatLng(e.latlng.lat, e.latlng.lng);
        });

        // 🔥 BẢN VÁ TÌM KIẾM THÔNG MINH: Có cơ chế tự động tìm lùi (chỉ tìm phường) nếu số nhà không tồn tại
        document.getElementById('btnTimViTri').addEventListener('click', function () {
            var address = document.getElementById('HiddenDiaChi').value;
            if (!address || address.length < 5) {
                alert("Vui lòng chọn đầy đủ Tỉnh/Quận/Phường và Số nhà!");
                return;
            }

            var cleanAddress = address.replace(/ \(.*?\)/g, '');
            var apiUrl = 'https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent(cleanAddress);

            fetch(apiUrl)
                .then(response => response.json())
                .then(data => {
                    if (data && data.length > 0) {
                        // TÌM THẤY CHÍNH XÁC SỐ NHÀ
                        var lat = data[0].lat;
                        var lon = data[0].lon;
                        map.flyTo([lat, lon], 17);
                        marker.setLatLng([lat, lon]);
                        updateLatLng(lat, lon);
                    } else {
                        // NẾU KHÔNG TÌM THẤY SỐ NHÀ -> CẮT BỎ SỐ NHÀ, CHỈ TÌM PHƯỜNG + QUẬN
                        var parts = cleanAddress.split(',');
                        if (parts.length > 1) {
                            var fallbackAddress = parts.slice(1).join(',').trim();
                            var fallbackUrl = 'https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent(fallbackAddress);

                            fetch(fallbackUrl)
                                .then(res => res.json())
                                .then(fbData => {
                                    if(fbData && fbData.length > 0) {
                                        var lat = fbData[0].lat;
                                        var lon = fbData[0].lon;
                                        map.flyTo([lat, lon], 15);
                                        marker.setLatLng([lat, lon]);
                                        updateLatLng(lat, lon);
                                        alert("Hệ thống không tìm thấy số nhà cụ thể này. Bản đồ đã được di chuyển đến khu vực: " + fallbackAddress + ". Vui lòng kéo ghim đến đúng vị trí nhà trọ của bạn!");
                                    } else {
                                        alert("Vẫn không tìm thấy khu vực này. Bạn hãy tự kéo ghim đến đúng vị trí nhé!");
                                    }
                                });
                        } else {
                            alert("Bản đồ không tìm thấy tọa độ chính xác. Bạn có thể kéo thả ghim bằng tay nhé!");
                        }
                    }
                })
                .catch(error => { console.error('Lỗi API Map:', error); });
        });

        // NÚT LẤY VỊ TRÍ HIỆN TẠI (GPS)
        document.getElementById('btnCurrentLocation').addEventListener('click', function() {
            if (navigator.geolocation) {
                let btn = this;
                let oldText = btn.innerHTML;
                btn.innerHTML = '⏳ Đang định vị...';

                navigator.geolocation.getCurrentPosition(function(position) {
                    var lat = position.coords.latitude;
                    var lng = position.coords.longitude;

                    map.flyTo([lat, lng], 17);
                    marker.setLatLng([lat, lng]);
                    updateLatLng(lat, lng);

                    btn.innerHTML = oldText;
                }, function(error) {
                    alert("❌ Không thể lấy vị trí. Vui lòng kiểm tra xem bạn đã cho phép trình duyệt truy cập vị trí chưa.");
                    btn.innerHTML = oldText;
                }, { enableHighAccuracy: true });
            } else {
                alert("❌ Trình duyệt của bạn không hỗ trợ định vị GPS.");
            }
        });

        // --- 2. XỬ LÝ API HÀNH CHÍNH QUỐC GIA ---
        document.addEventListener("DOMContentLoaded", function () {
            const cboCity = document.getElementById('cboCity');
            const cboDistrict = document.getElementById('cboDistrict');
            const cboWard = document.getElementById('cboWard');
            const txtStreet = document.getElementById('txtStreet');
            const hiddenDiaChi = document.getElementById('HiddenDiaChi');

            // Lấy chuỗi đa ngôn ngữ cho JS
            const txtSelectDistrict = document.getElementById("langSelectDistrict").value;
            const txtSelectWard = document.getElementById("langSelectWard").value;
            let locationData = [];

            // Gọi toàn bộ dữ liệu 63 Tỉnh Thành VN
            fetch('https://provinces.open-api.vn/api/?depth=3')
                .then(res => res.json())
                .then(apiData => {
                    locationData = apiData;
                    // Đưa HCM lên đầu danh sách
                    let hcmIdx = locationData.findIndex(p => p.code === 79);
                    if (hcmIdx !== -1) {
                        let hcm = locationData.splice(hcmIdx, 1)[0];
                        locationData.unshift(hcm);
                    }
                    locationData.forEach(city => {
                        cboCity.add(new Option(city.name, city.code));
                    });
                });

            cboCity.addEventListener('change', function () {
                cboDistrict.innerHTML = `<option value="">-- ${txtSelectDistrict} --</option>`;
                cboWard.innerHTML = `<option value="">-- ${txtSelectWard} --</option>`;
                cboWard.disabled = true;

                if (this.value) {
                    const selectedCity = locationData.find(c => c.code == this.value);
                    selectedCity.districts.forEach(district => {
                        let distName = district.name;
                        // Ghi chú cho TP Thủ Đức
                        if(distName === "Thành phố Thủ Đức") distName = "TP Thủ Đức (Quận 2, 9, Thủ Đức cũ)";

                        cboDistrict.add(new Option(distName, district.code));
                    });
                    cboDistrict.disabled = false;
                } else {
                    cboDistrict.disabled = true;
                }
                updateHiddenAddress();
            });

            cboDistrict.addEventListener('change', function () {
                cboWard.innerHTML = `<option value="">-- ${txtSelectWard} --</option>`;
                if (this.value) {
                    const selectedCity = locationData.find(c => c.code == cboCity.value);
                    const selectedDistrict = selectedCity.districts.find(d => d.code == this.value);
                    selectedDistrict.wards.forEach(ward => {
                        cboWard.add(new Option(ward.name, ward.code));
                    });
                    cboWard.disabled = false;
                } else {
                    cboWard.disabled = true;
                }
                updateHiddenAddress();
            });

            cboWard.addEventListener('change', updateHiddenAddress);
            txtStreet.addEventListener('keyup', updateHiddenAddress);

            function updateHiddenAddress() {
                let addressParts = [];
                if (txtStreet.value.trim()) addressParts.push(txtStreet.value.trim());
                if (cboWard.value) addressParts.push(cboWard.options[cboWard.selectedIndex].text);
                if (cboDistrict.value) addressParts.push(cboDistrict.options[cboDistrict.selectedIndex].text);
                if (cboCity.value) addressParts.push(cboCity.options[cboCity.selectedIndex].text);

                hiddenDiaChi.value = addressParts.join(', ');
            }
        });
    </script>
}