@model IEnumerable<Do_an_co_so.Models.AppUser>
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Do_an_co_so.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["AdminUserManagement"];
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-danger fw-bold m-0">@Localizer["SystemUserManagement"]</h2>
        <a asp-action="QuanLyBaoCao" class="btn btn-warning fw-bold shadow-sm">
            🚩 @Localizer["ViewScamReports"]
        </a>
    </div>
    <hr />

    <div class="table-responsive">
        <table class="table table-bordered table-hover mt-3 align-middle">
            <thead class="table-dark text-center">
                <tr>
                    <th>@Localizer["FullName"]</th>
                    <th>@Localizer["EmailAccount"]</th>
                    <th>@Localizer["LockStatus"]</th>
                    <th>@Localizer["eKYCStatus"]</th>
                    <th>@Localizer["VerificationProfile"]</th>
                    <th>@Localizer["AdminActions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="fw-bold">@user.HoTen</td>
                        <td>@user.Email</td>

                        <td class="text-center">
                            @if (user.TrangThaiKhoa)
                            {
                                <span class="badge bg-danger p-2"><i class="bi bi-lock-fill"></i> @Localizer["Locked"]</span>
                            }
                            else
                            {
                                <span class="badge bg-success p-2"><i class="bi bi-unlock-fill"></i> @Localizer["Active"]</span>
                            }
                        </td>

                        <td class="text-center">
                            @if (user.TrangThaiXacThuc == "Đã duyệt")
                            {
                                <span class="badge bg-primary p-2"><i class="bi bi-shield-check"></i> @Localizer["Verified"]</span>
                            }
                            else if (user.TrangThaiXacThuc == "Chờ duyệt")
                            {
                                <span class="badge bg-warning text-dark p-2 animate__animated animate__pulse animate__infinite"><i class="bi bi-hourglass-split"></i> @Localizer["PendingReview"]</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary p-2">@Localizer["None"]</span>
                            }
                        </td>

                        <td>
                            @if (user.TrangThaiXacThuc == "Chờ duyệt" || user.TrangThaiXacThuc == "Đã duyệt")
                            {
                                <div class="d-flex flex-column gap-2 align-items-center">
                                    <div class="d-flex gap-1">
                                        <a href="~/images/cccd/@user.CCCDTruoc" target="_blank">
                                            <img src="~/images/cccd/@user.CCCDTruoc" alt="@Localizer["FrontSide"]" class="img-thumbnail" style="width: 80px; height: 50px; object-fit: cover; cursor:pointer;" title="@Localizer["ClickToEnlarge"]" />
                                        </a>
                                        <a href="~/images/cccd/@user.CCCDSau" target="_blank">
                                            <img src="~/images/cccd/@user.CCCDSau" alt="@Localizer["BackSide"]" class="img-thumbnail" style="width: 80px; height: 50px; object-fit: cover; cursor:pointer;" title="@Localizer["ClickToEnlarge"]" />
                                        </a>
                                    </div>
                                    @if (!string.IsNullOrEmpty(user.SoCCCDQuetDuoc))
                                    {
                                        <small class="text-success fw-bold bg-light p-1 rounded border border-success">@Localizer["AIScan"]: @user.SoCCCDQuetDuoc</small>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted fst-italic text-center d-block">@Localizer["EmptyProfile"]</span>
                            }
                        </td>

                        <td>
                            <div class="d-flex flex-column gap-2">
                                <form asp-action="ToggleLockUser" asp-route-id="@user.Id" method="post">
                                    <button type="submit" class="btn btn-sm w-100 @(user.TrangThaiKhoa ? "btn-outline-success" : "btn-outline-warning")">
                                        @(user.TrangThaiKhoa? Localizer["Unlock"].Value : Localizer["LockAccount"].Value)
                                    </button>
                                </form>

                                @if (user.TrangThaiXacThuc == "Chờ duyệt")
                                {
                                    <div class="d-flex gap-1 mt-1 border-top pt-2">
                                        <form asp-action="DuyetCCCD" method="post" class="w-50">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <input type="hidden" name="hanhDong" value="Duyet" />
                                            <button type="submit" class="btn btn-sm btn-success w-100 fw-bold" onclick="return confirm('@Localizer["ConfirmValidCCCD"]');">@Localizer["Approve"]</button>
                                        </form>
                                        <form asp-action="DuyetCCCD" method="post" class="w-50">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <input type="hidden" name="hanhDong" value="TuChoi" />
                                            <button type="submit" class="btn btn-sm btn-secondary w-100 fw-bold" onclick="return confirm('@Localizer["ConfirmRejectProfile"]');">@Localizer["Reject"]</button>
                                        </form>
                                    </div>
                                }

                                <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="mt-1" onsubmit="return confirm('@Localizer["ConfirmDeleteAccount1"] @user.Email @Localizer["ConfirmDeleteAccount2"]');">
                                    <button type="submit" class="btn btn-sm btn-danger w-100">@Localizer["PermanentDelete"]</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>