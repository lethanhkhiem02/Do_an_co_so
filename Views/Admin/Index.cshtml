@model IEnumerable<Do_an_co_so.Models.AppUser>

@{
    ViewData["Title"] = "Quản lý người dùng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-danger fw-bold m-0">QUẢN LÝ NGƯỜI DÙNG HỆ THỐNG</h2>
        <a asp-action="QuanLyBaoCao" class="btn btn-warning fw-bold shadow-sm">
            🚩 Xem Đơn Tố Cáo Lừa Đảo
        </a>
    </div>
    <hr />

    <table class="table table-bordered table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>Họ và Tên</th>
                <th>Email / Tài khoản</th>
                <th>Trạng thái</th>
                <th>Hành động của Admin</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.HoTen</td>
                    <td>@user.Email</td>
                    <td>
                        @if (user.TrangThaiKhoa)
                        {
                            <span class="badge bg-danger">Đang bị khóa</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Hoạt động</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-2">
                            <form asp-action="ToggleLockUser" asp-route-id="@user.Id" method="post">
                                <button type="submit" class="btn btn-sm @(user.TrangThaiKhoa ? "btn-success" : "btn-warning")">
                                    @(user.TrangThaiKhoa ? "Mở Khóa" : "Khóa Tài Khoản")
                                </button>
                            </form>

                            <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" onsubmit="return confirm('Bạn có CHẮC CHẮN muốn xóa vĩnh viễn tài khoản @user.Email này không? Mọi dữ liệu của họ sẽ bị mất!');">
                                <button type="submit" class="btn btn-sm btn-danger">Xóa Vĩnh Viễn</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>