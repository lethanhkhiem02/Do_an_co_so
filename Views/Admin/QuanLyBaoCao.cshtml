@model IEnumerable<Do_an_co_so.Models.BaoCao>

@{
    ViewData["Title"] = "Quản lý Báo cáo lừa đảo";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-danger fw-bold m-0">🚩 QUẢN LÝ ĐƠN TỐ CÁO HỆ THỐNG</h2>
        <a asp-action="Index" class="btn btn-primary fw-bold shadow-sm">
            <i class="bi bi-people-fill"></i> Quản lý Người dùng
        </a>
    </div>
    <hr />

    <div class="table-responsive mt-3 shadow-sm rounded">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-dark text-center">
                <tr>
                    <th width="12%">Ngày gửi</th>
                    <th width="15%">Người tố cáo</th>
                    <th width="22%">Đối tượng bị tố cáo</th>
                    <th width="15%">Lý do</th>
                    <th width="21%">Chi tiết cụ thể</th>
                    <th width="15%">Xử lý</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center p-4 text-muted fw-bold">
                            Tạm thời hệ thống an toàn, chưa có đơn tố cáo nào! 🎉
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var bc in Model)
                    {
                        <tr>
                            <td class="text-center text-muted small">@bc.NgayBaoCao.ToString("dd/MM/yyyy HH:mm")</td>

                            <td class="text-primary fw-bold">
                                @(bc.NguoiBaoCao?.HoTen ?? bc.NguoiBaoCao?.Email ?? "Ẩn danh")
                            </td>

                            <td>
                                @if (bc.PhongTroId != null)
                                {
                                    <span class="badge bg-info text-dark mb-1"><i class="bi bi-house-door"></i> Báo cáo Phòng</span>
                        
                                    <br />
                                    <a asp-controller="PhongTro" asp-action="Details" asp-route-id="@bc.PhongTroId" class="text-decoration-none fw-bold" target="_blank">
                                        Xem phòng này 🔗
                                    </a>
                                    <br />
                                    <small class="text-danger">Chủ trọ: @(bc.PhongTro?.ChuTro?.HoTen ?? "Khuyết danh")</small>
                                }
                                else if (bc.NguoiBiBaoCaoId != null)
                                {
                                    <span class="badge bg-warning text-dark mb-1"><i class="bi bi-chat-dots"></i> Báo cáo Tin nhắn</span>
                        
                                    <br />
                                    <strong class="text-danger">@(bc.NguoiBiBaoCao?.HoTen ?? bc.NguoiBiBaoCao?.Email ?? "Tài khoản ẩn")</strong>
                                    <br />
                                    <small class="text-muted">ID: @bc.NguoiBiBaoCaoId.Substring(0, 8)...</small>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Dữ liệu đã bị xóa</span>
                                }
                            </td>

                            <td class="text-danger fw-bold">@bc.LyDo</td>
                            <td style="white-space: pre-line;">@(string.IsNullOrEmpty(bc.ChiTiet) ? "(Không có)" : bc.ChiTiet)</td>

                            <td class="text-center">
                                @if (bc.DaXuLy)
                                {
                                    <span class="badge bg-success p-2 w-100"><i class="bi bi-check-circle"></i> Đã giải quyết</span>
                                }
                                else
                                {
                                    <form asp-action="XacNhanDaXuLy" asp-route-id="@bc.Id" method="post">
                                        <button type="submit" class="btn btn-warning btn-sm fw-bold w-100" onclick="return confirm('Xác nhận bạn đã xử lý xong đơn tố cáo này?');">
                                            Đánh dấu Xong
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>