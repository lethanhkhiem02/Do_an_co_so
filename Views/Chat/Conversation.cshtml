@model IEnumerable<Do_an_co_so.Models.Message>

@{
    var receiver = ViewBag.Receiver as Do_an_co_so.Models.AppUser;
    var currentUserId = ViewBag.CurrentUserId as string;
    ViewData["Title"] = "Chat với " + (receiver?.HoTen ?? "Người dùng");
}

<style>
    /* Làm gọn thanh cuộn (scrollbar) */
    #chatBox::-webkit-scrollbar {
        width: 6px;
    }

    #chatBox::-webkit-scrollbar-thumb {
        background-color: #ced4da;
        border-radius: 10px;
    }

    #chatBox::-webkit-scrollbar-track {
        background-color: transparent;
    }

    /* Bong bóng chat */
    .msg-bubble {
        max-width: 75%;
        word-wrap: break-word;
    }

    /* Emoji hiệu ứng */
    .emoji-item {
        cursor: pointer;
        transition: transform 0.1s;
    }

        .emoji-item:hover {
            transform: scale(1.2);
        }

    /* Typing indicator animation */
    .typing-dot {
        animation: typing 1.4s infinite ease-in-out both;
        background-color: #6c757d;
        border-radius: 50%;
        display: inline-block;
        height: 6px;
        width: 6px;
        margin: 0 1px;
    }

        .typing-dot:nth-child(1) {
            animation-delay: -0.32s;
        }

        .typing-dot:nth-child(2) {
            animation-delay: -0.16s;
        }

    @@keyframes typing {
        0%, 80%, 100% {
            transform: scale(0);
        }

        40% {
            transform: scale(1);
        }
    }
</style>

<div class="container mt-4 mb-5">

    <div class="col-md-10 mx-auto mb-2">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show fw-bold shadow-sm" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <div class="col-md-10 mx-auto">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-white border-bottom d-flex align-items-center p-3">
                <a asp-action="Index" class="text-dark me-3 text-decoration-none fs-5" title="Quay lại hộp thư">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" /></svg>
                </a>
                <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-3 fw-bold" style="width: 45px; height: 45px; font-size: 18px;">
                    @(string.IsNullOrEmpty(receiver?.HoTen) ? "U" : receiver.HoTen.Substring(0, 1).ToUpper())
                </div>
                <div>
                    <h6 class="mb-0 fw-bold fs-5">@((receiver?.HoTen ?? receiver?.Email))</h6>
                    <small class="text-success">● Đang hoạt động</small>
                </div>

                <button type="button" class="btn btn-sm btn-outline-danger ms-auto fw-bold rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#reportUserModal">
                    🚩 Báo cáo
                </button>
            </div>

            <div class="card-body p-4 d-flex flex-column" style="height: 500px; overflow-y: auto; background-color: #f8f9fa;" id="chatBox">
                @if (!Model.Any())
                {
                    <div class="text-center text-muted mt-5" id="emptyMessage">
                        <p class="fs-1 mb-0">👋</p>
                        <p>Hãy gửi lời chào đầu tiên để bắt đầu trò chuyện!</p>
                    </div>
                }
                else
                {
                    DateTime? lastDate = null;
                    foreach (var msg in Model)
                    {
                        var msgDate = msg.Timestamp.Date;
                        if (lastDate != msgDate)
                        {
                            string dateLabel = msgDate == DateTime.Today ? "Hôm nay" :
                            msgDate == DateTime.Today.AddDays(-1) ? "Hôm qua" :
                            msgDate.ToString("dd/MM/yyyy");
                            <div class="text-center my-3">
                                <span class="badge bg-secondary rounded-pill text-light px-3 py-1" style="font-weight: 500; opacity: 0.6;">@dateLabel</span>
                            </div>
                            lastDate = msgDate;
                        }

                        bool isMyMessage = msg.SenderId == currentUserId;
                        var alignClass = isMyMessage ? "align-items-end" : "align-items-start";
                        var bubbleClass = isMyMessage ? "bg-primary text-white rounded-4 rounded-bottom-0 rounded-start-4" : "bg-white border text-dark rounded-4 rounded-bottom-0 rounded-end-4";
                        <div class="d-flex flex-column @alignClass mb-3">
                            <div class="msg-bubble p-2 px-3 shadow-sm @bubbleClass">
                                @if (msg.Content.StartsWith("[IMG]:"))
                                {
                                    <img src="@msg.Content.Replace("[IMG]:", "")" class="img-fluid rounded" style="max-height: 200px; cursor: pointer;" onclick="window.open(this.src)" />
                                }
                                else
                                {
                                    <span style="white-space: pre-line;">@msg.Content</span>
                                }
                            </div>
                            <small class="text-muted mt-1 px-1" style="font-size: 0.7rem;">@msg.Timestamp.ToString("HH:mm")</small>
                        </div>
                    }
                }

                <div id="typingIndicator" class="d-flex align-items-center mb-3 d-none">
                    <div class="bg-white border text-dark rounded-4 rounded-bottom-0 rounded-end-4 p-2 px-3 shadow-sm d-inline-block">
                        <span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-white p-3 border-top position-relative">

                <div id="emojiPicker" class="position-absolute bg-white border rounded-3 shadow p-2 d-none" style="bottom: 80px; left: 20px; width: 260px; z-index: 1000;">
                    <div class="d-flex flex-wrap gap-2 fs-4">
                        <span class="emoji-item">😀</span> <span class="emoji-item">😂</span> <span class="emoji-item">🥰</span>
                        <span class="emoji-item">😎</span> <span class="emoji-item">🤔</span> <span class="emoji-item">😭</span>
                        <span class="emoji-item">👍</span> <span class="emoji-item">👎</span> <span class="emoji-item">❤️</span>
                    </div>
                </div>

                <div class="d-flex align-items-center">
                    <input type="hidden" id="currentUserId" value="@currentUserId" />
                    <input type="hidden" id="receiverId" value="@receiver?.Id" />

                    <button class="btn btn-light text-secondary rounded-circle me-1 d-flex justify-content-center align-items-center" id="emojiToggleBtn" type="button" style="width: 45px; height: 45px;">😀</button>

                    <button class="btn btn-light text-secondary rounded-circle me-2 d-flex justify-content-center align-items-center" id="imageSelectBtn" type="button" style="width: 45px; height: 45px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16"><path d="M4 0h5.293A1 1 0 0 1 10 .293L13.707 4a1 1 0 0 1 .293.707V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2zm5.5 1.5v2a1 1 0 0 0 1 1h2l-3-3zM1 2v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1zm4 2.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0zM3 13h10v-1c0-.442-.42-.82-.998-1.018l-1.806-.602a1 1 0 0 0-.61.028l-1.5 1.5a.5.5 0 0 1-.708 0L6.2 10.7a.5.5 0 0 0-.632.064L3 13z" /></svg>
                    </button>
                    <input type="file" id="imageInput" class="d-none" accept="image/*" />

                    <input type="text" id="messageContent" class="form-control rounded-pill bg-light border-0 px-4 py-2 me-2" placeholder="Nhập tin nhắn..." autocomplete="off" />

                    <button type="button" id="sendPrivateBtn" class="btn btn-primary rounded-circle shadow-sm d-flex justify-content-center align-items-center" style="width: 45px; height: 45px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16"><path d="M15.964.686a.5.5 0 0 0-.65-.65L.767 5.855H.766l-.452.18a.5.5 0 0 0-.082.887l.41.26.001.002 4.995 3.178 3.178 4.995.002.002.26.41a.5.5 0 0 0 .886-.083zm-1.833 1.89L6.637 10.07l-.215-.338a.5.5 0 0 0-.154-.154l-.338-.215 7.494-7.494 1.178-.471z" /></svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="reportUserModal" tabindex="-1" aria-labelledby="reportUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="reportUserModalLabel">🚩 BÁO CÁO NGƯỜI DÙNG NÀY</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Chat" asp-action="SubmitUserReport" method="post">
                <div class="modal-body">
                    <input type="hidden" name="nguoiBiBaoCaoId" value="@receiver?.Id" />
                    <p class="text-muted small mb-3">Nếu người này có hành vi đe dọa, xúc phạm hoặc lừa đảo, hãy báo cáo ngay để Admin khóa tài khoản nhé!</p>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Lý do báo cáo: <span class="text-danger">*</span></label>
                        <select name="lyDo" class="form-select border-danger" required>
                            <option value="">-- Chọn lý do --</option>
                            <option value="Ngôn từ đả kích, chửi thề, xúc phạm">Ngôn từ đả kích, chửi thề, xúc phạm</option>
                            <option value="Quấy rối, làm phiền">Quấy rối, làm phiền liên tục</option>
                            <option value="Lừa đảo chiếm đoạt tài sản">Lừa đảo chiếm đoạt tài sản</option>
                            <option value="Gửi tin nhắn rác / Spam">Gửi tin nhắn rác / Spam</option>
                            <option value="Khác">Lý do khác...</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Chi tiết thêm (không bắt buộc):</label>
                        <textarea name="chiTiet" class="form-control" rows="3" placeholder="Ghi chú thêm về hành vi vi phạm..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-danger fw-bold">Gửi Báo Cáo 🚀</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>
    <script>
        var chatBox = document.getElementById("chatBox");
        var messageInput = document.getElementById("messageContent");
        var currentUserId = document.getElementById("currentUserId").value;
        var receiverId = document.getElementById("receiverId").value;
        var typingIndicator = document.getElementById("typingIndicator");

        function scrollToBottom() { chatBox.scrollTop = chatBox.scrollHeight; }
        window.onload = scrollToBottom;

        // Xử lý UI Emoji
        document.getElementById("emojiToggleBtn").addEventListener("click", () => document.getElementById("emojiPicker").classList.toggle("d-none"));

        document.querySelectorAll(".emoji-item").forEach(emoji => {
            emoji.addEventListener("click", function() {
                messageInput.value += this.innerText;
                messageInput.focus();
            });
        });

        // Xử lý Upload Hình ảnh
        var imgInput = document.getElementById("imageInput");

        document.getElementById("imageSelectBtn").addEventListener("click", () => imgInput.click());
        imgInput.addEventListener("change", function() {
            var file = this.files[0];
            if(!file) return;
            var formData = new FormData();
            formData.append("file", file);

            fetch('/Chat/UploadImage', { method: 'POST', body: formData })
            .then(res => res.json())
            .then(result => {
                if(result.success) {
                    // Gắn tiền tố [IMG]: để Backend vẫn lưu dạng string bình thường
                    connection.invoke("SendPrivateMessage", currentUserId, receiverId, "[IMG]:" + result.imageUrl);
                    imgInput.value = "";
                } else alert(result.message);
            }).catch(e => alert("Lỗi upload ảnh"));
        });

        var connection = new signalR.HubConnectionBuilder().withUrl("/chatHub").build();

        // 1. Nhận tin nhắn Real-time
        connection.on("ReceivePrivateMessage", function (senderId, message, time) {
            if (senderId === currentUserId || senderId === receiverId) {
                var emptyMsg = document.getElementById("emptyMessage");
                if(emptyMsg) emptyMsg.style.display = "none";

                var isMyMessage = (senderId === currentUserId);
                var alignClass = isMyMessage ? "align-items-end" : "align-items-start";
                var bubbleClass = isMyMessage ? "bg-primary text-white rounded-4 rounded-bottom-0 rounded-start-4" : "bg-white border text-dark rounded-4 rounded-bottom-0 rounded-end-4";

                // Parse hình ảnh nếu có tiền tố [IMG]:
                var contentHtml = message;
                if(message.startsWith("[IMG]:")) {
                    var url = message.replace("[IMG]:", "");
                    contentHtml = `<img src="${url}" class="img-fluid rounded" style="max-height: 200px; cursor: pointer;" onclick="window.open(this.src)" />`;
                } else {
                    contentHtml = `<span style="white-space: pre-line;">${message}</span>`;
                }

                var msgHtml = `
                    <div class="d-flex flex-column ${alignClass} mb-3">
                        <div class="msg-bubble p-2 px-3 shadow-sm ${bubbleClass}">
                            ${contentHtml}
                        </div>
                        <small class="text-muted mt-1 px-1" style="font-size: 0.7rem;">${time}</small>
                    </div>
                `;

                // Chèn tin nhắn mới vào trước thẻ typingIndicator
                typingIndicator.insertAdjacentHTML('beforebegin', msgHtml);
                scrollToBottom();
            }
        });

        // 2. Lắng nghe trạng thái Đang gõ
        connection.on("ReceiveTypingState", function (senderId, isTyping) {
            if (senderId === receiverId) {
                typingIndicator.classList.toggle("d-none", !isTyping);
                if (isTyping) scrollToBottom();
            }
        });

        connection.start();

        // Xử lý gửi tin nhắn
        function sendPrivateMessage() {
            var msg = messageInput.value;
            if (msg.trim() !== "") {
                connection.invoke("SendPrivateMessage", currentUserId, receiverId, msg);
                messageInput.value = "";
                messageInput.focus();
                document.getElementById("emojiPicker").classList.add("d-none");
                // Tắt trạng thái đang gõ ngay khi gửi
                connection.invoke("SendTypingState", currentUserId, receiverId, false);
            }
        }

        document.getElementById("sendPrivateBtn").addEventListener("click", sendPrivateMessage);

        // 3. Bắt sự kiện bàn phím cho Đang gõ & Gửi (Enter)
        let typingTimer;
        const typingInterval = 1500; // Ngừng gõ 1.5s thì tắt thông báo

        messageInput.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                clearTimeout(typingTimer);
                sendPrivateMessage();
            } else {
                // Đánh tín hiệu đang gõ
                connection.invoke("SendTypingState", currentUserId, receiverId, true);
                clearTimeout(typingTimer);
                typingTimer = setTimeout(() => {
                    connection.invoke("SendTypingState", currentUserId, receiverId, false);
                }, typingInterval);
            }
        });
    </script>
}