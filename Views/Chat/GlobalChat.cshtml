@using Newtonsoft.Json
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Do_an_co_so.SharedResource> Localizer
@model dynamic

<style>
    /* Làm gọn thanh cuộn (scrollbar) */
    #chatBox::-webkit-scrollbar {
        width: 6px;
    }

    #chatBox::-webkit-scrollbar-thumb {
        background-color: #ced4da;
        border-radius: 10px;
    }

    #chatBox::-webkit-scrollbar-track {
        background-color: transparent;
    }

    /* Bong bóng chat */
    .msg-bubble {
        max-width: 75%;
        word-wrap: break-word;
    }

    /* Emoji hiệu ứng */
    .emoji-item {
        cursor: pointer;
        transition: transform 0.1s;
    }

        .emoji-item:hover {
            transform: scale(1.2);
        }

    /* Ảnh trong khung chat */
    .chat-image {
        max-width: 250px;
        max-height: 250px;
        border-radius: 10px;
        cursor: pointer;
        transition: 0.2s;
    }

        .chat-image:hover {
            opacity: 0.9;
        }
</style>

<div class="container mt-4 mb-5 position-relative">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-dark text-white rounded-top-4 py-3 d-flex align-items-center">
            <h5 class="mb-0 fw-bold">@Localizer["GlobalChatRoom"]</h5>
        </div>

        <div class="card-body p-0">
            <div id="chatBox" class="p-4 d-flex flex-column" style="height: 550px; overflow-y: auto; background-color: #f8f9fa;">
                @foreach (var item in Model)
                {
                    bool isMe = item.SenderName == ViewBag.CurrentUserName;

                    <div class="d-flex flex-column @(isMe ? "align-items-end" : "align-items-start") mb-3">
                        <small class="text-muted mb-1 px-1" style="font-size: 0.75rem;">
                            @(isMe? Localizer["You"].Value : item.SenderName) • @item.Time
                        </small>
                        <div class="msg-bubble p-2 px-3 shadow-sm @(isMe ? "bg-dark text-white rounded-4 rounded-bottom-0 rounded-start-4" : "bg-white border text-dark rounded-4 rounded-bottom-0 rounded-end-4")">
                            @if (item.Type == "text")
                            {
                                @item.Content
                            }
                            else if (item.Type == "image")
                            {
                                <img src="@item.Content" class="chat-image" onclick="window.open(this.src)" />
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card-footer bg-white border-top-0 rounded-bottom-4 p-3 position-relative">

            <div id="emojiPicker" class="position-absolute bg-white border rounded-3 shadow p-2 d-none" style="bottom: 75px; left: 20px; width: 260px; z-index: 1000;">
                <div class="d-flex flex-wrap gap-2 fs-4">
                    <span class="emoji-item">😀</span> <span class="emoji-item">😂</span> <span class="emoji-item">🥰</span>
                    <span class="emoji-item">😎</span> <span class="emoji-item">🤔</span> <span class="emoji-item">😭</span>
                    <span class="emoji-item">👍</span> <span class="emoji-item">👎</span> <span class="emoji-item">❤️</span>
                    <span class="emoji-item">🔥</span> <span class="emoji-item">✨</span> <span class="emoji-item">🎉</span>
                </div>
            </div>

            <div class="input-group align-items-center">

                <button class="btn btn-light text-secondary rounded-circle me-1" id="emojiToggleBtn" type="button" style="width: 42px; height: 42px;">😀</button>

                <button class="btn btn-light text-secondary rounded-circle me-2" id="imageSelectBtn" type="button" style="width: 42px; height: 42px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M4 0h5.293A1 1 0 0 1 10 .293L13.707 4a1 1 0 0 1 .293.707V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2zm5.5 1.5v2a1 1 0 0 0 1 1h2l-3-3zM1 2v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1zm4 2.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0zM3 13h10v-1c0-.442-.42-.82-.998-1.018l-1.806-.602a1 1 0 0 0-.61.028l-1.5 1.5a.5.5 0 0 1-.708 0L6.2 10.7a.5.5 0 0 0-.632.064L3 13z" />
                    </svg>
                </button>

                <input type="file" id="imageInput" class="d-none" accept="image/*" />

                <input type="text" id="messageInput" class="form-control rounded-pill bg-light border-0 px-4 me-2" placeholder="@Localizer["TypeMessage"]" autocomplete="off">

                <button class="btn btn-dark rounded-circle shadow-sm d-flex align-items-center justify-content-center" id="sendBtn" style="width: 45px; height: 45px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M15.964.686a.5.5 0 0 0-.65-.65L.767 5.855H.766l-.452.18a.5.5 0 0 0-.082.887l.41.26.001.002 4.995 3.178 3.178 4.995.002.002.26.41a.5.5 0 0 0 .886-.083zm-1.833 1.89L6.637 10.07l-.215-.338a.5.5 0 0 0-.154-.154l-.338-.215 7.494-7.494 1.178-.471z" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="userId" value="@ViewBag.CurrentUserId" />
<input type="hidden" id="userName" value="@ViewBag.CurrentUserName" />

<!-- TRUYỀN BIẾN ĐA NGÔN NGỮ XUỐNG JAVASCRIPT -->
<input type="hidden" id="langYou" value="@Localizer["You"]" />
<input type="hidden" id="langUploadFail" value="@Localizer["UploadFailed"]" />
<input type="hidden" id="langUploadError" value="@Localizer["UploadError"]" />

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>
<script>
    var connection = new signalR.HubConnectionBuilder().withUrl("/chatHub").build();
    var currentUserName = document.getElementById("userName").value;
    var chatBox = document.getElementById("chatBox");
    var msgInput = document.getElementById("messageInput");

    // Lấy biến đa ngôn ngữ cho JS
    var textYou = document.getElementById("langYou").value;
    var textUploadFail = document.getElementById("langUploadFail").value;
    var textUploadError = document.getElementById("langUploadError").value;

    document.getElementById("emojiToggleBtn").addEventListener("click", () => document.getElementById("emojiPicker").classList.toggle("d-none"));
    document.querySelectorAll(".emoji-item").forEach(emoji => {
        emoji.addEventListener("click", function() { msgInput.value += this.innerText; msgInput.focus(); });
    });

    var imgInput = document.getElementById("imageInput");
    document.getElementById("imageSelectBtn").addEventListener("click", () => imgInput.click());

    imgInput.addEventListener("change", function() {
        var file = this.files[0];
        if(!file) return;

        var formData = new FormData();
        formData.append("file", file);

        fetch('/Chat/UploadImage', { method: 'POST', body: formData })
        .then(response => response.json())
        .then(result => {
            if(result.success) {
                var userId = document.getElementById("userId").value;
                var userName = document.getElementById("userName").value;
                connection.invoke("SendGlobalMessage", userId, userName, "image", result.imageUrl);
                imgInput.value = "";
            } else {
                alert(textUploadFail + result.message);
            }
        })
        .catch(error => alert(textUploadError));
    });

    function scrollToBottom() { chatBox.scrollTop = chatBox.scrollHeight; }
    window.onload = scrollToBottom;

    connection.on("ReceiveGlobalMessage", function (data) {
        var isMe = (data.user === currentUserName);
        var displayName = isMe ? textYou : data.user;
        var alignClass = isMe ? "align-items-end" : "align-items-start";
        var bubbleClass = isMe ? "bg-dark text-white rounded-4 rounded-bottom-0 rounded-start-4" : "bg-white border text-dark rounded-4 rounded-bottom-0 rounded-end-4";

        var contentHtml = '';
        if(data.type === "text") contentHtml = data.content;
        else if(data.type === "image") contentHtml = `<img src="${data.content}" class="chat-image" onclick="window.open(this.src)" />`;

        var msgHtml = `
            <div class="d-flex flex-column ${alignClass} mb-3">
                <small class="text-muted mb-1 px-1" style="font-size: 0.75rem;">${displayName} • ${data.time}</small>
                <div class="msg-bubble p-2 px-3 shadow-sm ${bubbleClass}">
                    ${contentHtml}
                </div>
            </div>
        `;

        chatBox.insertAdjacentHTML('beforeend', msgHtml);
        scrollToBottom();
    });

    connection.start();

    function triggerSendMessage() {
        var userId = document.getElementById("userId").value;
        var userName = document.getElementById("userName").value;
        var msg = msgInput.value;
        if(msg.trim() !== "") {
            connection.invoke("SendGlobalMessage", userId, userName, "text", msg);
            msgInput.value = "";
            msgInput.focus();
            document.getElementById("emojiPicker").classList.add("d-none");
        }
    }
    document.getElementById("sendBtn").addEventListener("click", triggerSendMessage);
    msgInput.addEventListener("keypress", event => { if (event.key === "Enter") { event.preventDefault(); triggerSendMessage(); } });
</script>