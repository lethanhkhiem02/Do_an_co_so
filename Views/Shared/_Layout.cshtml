@using Microsoft.AspNetCore.Identity
@using Do_an_co_so.Models
@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Localization
@inject UserManager<AppUser> UserManager
@inject IStringLocalizer<Do_an_co_so.SharedResource> Localizer

@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.UICulture.Name ?? "vi-VN";
}
<!DOCTYPE html>
<html lang="@(currentCulture == "en-US" ? "en" : "vi")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RoomFinder</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Do_an_co_so.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            background-color: var(--bg-color);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .navbar-custom {
            background-color: #ffffff;
            border-bottom: 1px solid #eaeaea;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            padding: 0.8rem 0;
        }

            .navbar-custom .navbar-brand {
                font-size: 1.5rem;
                color: #0d6efd;
                font-weight: 700;
            }

        .footer-main {
            background-color: #1a1d20;
            color: #a0aab2;
            padding: 2rem 0 1rem;
            margin-top: auto;
        }

        .footer-link {
            color: #a0aab2;
            text-decoration: none;
            display: block;
            margin-bottom: 0.8rem;
            transition: 0.2s;
        }

            .footer-link:hover {
                color: #0d6efd;
                padding-left: 5px;
            }

        /* 🔥 Style cho icon chat */
        #btnAiChat {
            cursor: grab;
            transition: transform 0.2s;
            animation: pulse 2s infinite;
        }

            #btnAiChat:active {
                cursor: grabbing;
            }

            #btnAiChat.dragging {
                animation: none;
                transform: scale(1.1);
                transition: none;
            }

        @@keyframes pulse {
            0% {
                box-shadow: 0 0 0 0 rgba(255, 193, 7, 0.7);
            }

            70% {
                box-shadow: 0 0 0 15px rgba(255, 193, 7, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(255, 193, 7, 0);
            }
        }

        /* Chatbox style */
        #aiChatBox {
            transition: none !important;
            will-change: top, left;
        }

        #aiChatHeader {
            cursor: grab;
            user-select: none;
        }

            #aiChatHeader:active {
                cursor: grabbing;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-heart-fill me-1"></i> RoomFinder
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">@Localizer["Home"]</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="PhongTro" asp-action="TimKiem">@Localizer["FindRoom"]</a></li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Chat" asp-action="Index">
                                    @Localizer["Messages"]
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-warning" asp-controller="Chat" asp-action="GlobalChat">
                                    @Localizer["GlobalChat"]
                                </a>
                            </li>

                            @if (User.IsInRole("SinhVien"))
                            {
                                <li class="nav-item ms-lg-2">
                                    <a class="nav-link fw-bold text-success" asp-controller="PhongTro" asp-action="PhongDaThue">
                                        <i class="bi bi-clock-history"></i> @Localizer["LichSuThue"]
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("ChuTro"))
                            {
                                var currentUser = await UserManager.GetUserAsync(User);
                                <li class="nav-item ms-lg-2 d-flex align-items-center">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
                                        @Localizer["Wallet"]: @(currentUser?.SoDu.ToString("N0") ?? "0")đ
                                    </span>
                                </li>
                                <li class="nav-item ms-2 d-flex align-items-center">
                                    <a class="btn btn-sm btn-outline-success rounded-pill fw-bold px-3" asp-controller="PhongTro" asp-action="NapTien">
                                        <i class="bi bi-credit-card me-1"></i> @Localizer["Deposit"]
                                    </a>
                                </li>
                                <li class="nav-item ms-2"><a class="nav-link text-primary fw-bold" asp-controller="PhongTro" asp-action="Create">+ @Localizer["PostRoom"]</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="PhongTro" asp-action="QuanLyPhong">@Localizer["ManagePosts"]</a></li>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-danger fw-bold" asp-area="" asp-controller="Admin" asp-action="Index">
                                        @Localizer["AdminManagement"]
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-flex align-items-center">
                        <div class="dropdown me-3">
                            <button class="btn btn-light dropdown-toggle rounded-pill shadow-sm fw-bold border" type="button" id="languageDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                @(currentCulture == "en-US" ? "🇬🇧 English" : "🇻🇳 Tiếng Việt")
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="languageDropdown">
                                <li>
                                    <a class="dropdown-item fw-bold @(currentCulture == "vi-VN" ? "active bg-primary" : "")"
                                       href="/Language/SetLanguage?culture=vi-VN&returnUrl=@Context.Request.Path@Context.Request.QueryString">
                                        🇻🇳 Tiếng Việt
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item fw-bold @(currentCulture == "en-US" ? "active bg-primary" : "")"
                                       href="/Language/SetLanguage?culture=en-US&returnUrl=@Context.Request.Path@Context.Request.QueryString">
                                        🇬🇧 English
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4 flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <button id="btnAiChat" class="btn btn-warning rounded-circle shadow-lg"
            style="position: fixed; bottom: 30px; right: 30px; width: 60px; height: 60px; z-index: 9999;"
            title="Mở trợ lý ảo">
        <i class="bi bi-robot fs-3 text-dark"></i>
    </button>

    <div id="aiChatBox" class="card shadow-lg d-none"
         style="position: fixed; bottom: 100px; right: 30px; width: 360px; z-index: 9999; border-radius: 12px; border: 2px solid #ffc107; overflow: hidden; background-color: white;">

        <div id="aiChatHeader" class="card-header bg-warning text-dark d-flex justify-content-between align-items-center p-3">
            <h6 class="mb-0 fw-bold"><i class="bi bi-robot me-2"></i>Trợ Lý RoomFinder</h6>
            <button type="button" class="btn-close btn-close-dark" onclick="toggleAiChat()" aria-label="Close"></button>
        </div>

        <div id="aiChatBody" class="card-body p-3" style="height: 350px; overflow-y: auto; background-color: #f8f9fa;">
            <div class="mb-3 text-start">
                <div class="d-inline-block p-2 rounded-3 shadow-sm bg-white text-dark border" style="max-width: 85%;">
                    👋 Chào bạn! Mình là Trợ lý tự động hỗ trợ tìm trọ cho sinh viên. Bạn cần giúp gì ạ?
                </div>
            </div>
        </div>

        <div class="card-footer bg-white p-2 border-top">
            <div class="input-group">
                <input type="text" id="aiInput" class="form-control border-warning shadow-none" placeholder="Nhập câu hỏi..." onkeypress="if(event.key === 'Enter') sendAiMessage()">
                <button class="btn btn-warning fw-bold" type="button" onclick="sendAiMessage()">Gửi</button>
            </div>
        </div>
    </div>

    <script>
        // Toggle chatbox
        function toggleAiChat() {
            document.getElementById('aiChatBox').classList.toggle('d-none');
        }

        // Gửi tin nhắn AI
        function sendAiMessage() {
            const input = document.getElementById('aiInput');
            const message = input.value.trim();
            if (message === '') return;

            appendAiMsg(message, true);
            input.value = '';

            const typingId = "typing_" + Date.now();
            appendAiMsg("<i>Đang soạn tin...</i>", false, typingId);

            fetch(`/Home/ChatWithAI?message=${encodeURIComponent(message)}`)
                .then(response => response.json())
                .then(data => {
                    const typingEl = document.getElementById(typingId);
                    if (typingEl) typingEl.remove();
                    appendAiMsg(data.reply, false);
                })
                .catch(error => {
                    const typingEl = document.getElementById(typingId);
                    if (typingEl) typingEl.remove();
                    appendAiMsg("⚠️ Hệ thống đang bận, vui lòng thử lại sau.", false);
                });
        }

        // Thêm tin nhắn vào khung chat
        function appendAiMsg(text, isUser, id = "") {
            const chatBody = document.getElementById('aiChatBody');
            const alignClass = isUser ? 'text-end' : 'text-start';
            const bgClass = isUser ? 'bg-warning text-dark fw-bold' : 'bg-white text-dark border';

            const msgHtml = `
                <div class="mb-3 ${alignClass}" ${id ? `id="${id}"` : ''}>
                    <div class="d-inline-block p-2 rounded-3 shadow-sm ${bgClass}"
                         style="max-width: 85%; text-align: left; word-wrap: break-word; white-space: pre-wrap;">
                        ${text}
                    </div>
                </div>
            `;
            chatBody.insertAdjacentHTML('beforeend', msgHtml);
            chatBody.scrollTop = chatBody.scrollHeight;
        }

        // 🔥 KÉO THẢ ICON VÀNG + PHÂN BIỆT CLICK/DRAG
        const iconBtn = document.getElementById('btnAiChat');
        let isDragging = false;
        let hasMoved = false;
        let startX, startY, initialLeft, initialTop;

        iconBtn.addEventListener('mousedown', (e) => {
            if (e.button !== 0) return;
            hasMoved = false;
            startX = e.clientX;
            startY = e.clientY;

            const rect = iconBtn.getBoundingClientRect();
            initialLeft = rect.left;
            initialTop = rect.top;

            iconBtn.style.bottom = 'auto';
            iconBtn.style.right = 'auto';
            iconBtn.style.left = initialLeft + 'px';
            iconBtn.style.top = initialTop + 'px';
            iconBtn.classList.add('dragging');

            document.addEventListener('mousemove', onDrag);
            document.addEventListener('mouseup', onDrop);
        });

        function onDrag(e) {
            const dx = e.clientX - startX;
            const dy = e.clientY - startY;
            if (Math.abs(dx) > 4 || Math.abs(dy) > 4) {
                isDragging = true;
                hasMoved = true;
            }
            if (isDragging) {
                let newLeft = initialLeft + (e.clientX - startX);
                let newTop = initialTop + (e.clientY - startY);

                const w = window.innerWidth;
                const h = window.innerHeight;
                const bw = iconBtn.offsetWidth;
                const bh = iconBtn.offsetHeight;

                newLeft = Math.max(0, Math.min(w - bw, newLeft));
                newTop = Math.max(0, Math.min(h - bh, newTop));

                iconBtn.style.left = newLeft + 'px';
                iconBtn.style.top = newTop + 'px';
            }
        }

        function onDrop() {
            document.removeEventListener('mousemove', onDrag);
            document.removeEventListener('mouseup', onDrop);

            iconBtn.classList.remove('dragging');
            isDragging = false;

            if (!hasMoved) {
                toggleAiChat();
            }
        }

        // 🔥 KÉO THẢ KHUNG CHAT
        const chatBox = document.getElementById("aiChatBox");
        const dragHandle = document.getElementById("aiChatHeader");
        let chatDragging = false, chatStartX, chatStartY, chatOffsetX = 0, chatOffsetY = 0;

        if (dragHandle) {
            dragHandle.addEventListener("mousedown", (e) => {
                if (e.target.closest('.btn-close')) return;
                chatDragging = true;
                const rect = chatBox.getBoundingClientRect();
                chatOffsetX = rect.left;
                chatOffsetY = rect.top;
                chatStartX = e.clientX;
                chatStartY = e.clientY;
                chatBox.style.bottom = 'auto';
                chatBox.style.right = 'auto';
                chatBox.style.top = chatOffsetY + 'px';
                chatBox.style.left = chatOffsetX + 'px';
                chatBox.style.transition = 'none';
                document.addEventListener('mousemove', chatDrag);
                document.addEventListener('mouseup', chatDrop);
                e.preventDefault();
            });
        }

        function chatDrag(e) {
            if (!chatDragging) return;
            let newLeft = chatOffsetX + (e.clientX - chatStartX);
            let newTop = chatOffsetY + (e.clientY - chatStartY);
            newLeft = Math.max(0, Math.min(window.innerWidth - chatBox.offsetWidth, newLeft));
            newTop = Math.max(0, Math.min(window.innerHeight - chatBox.offsetHeight, newTop));
            chatBox.style.left = newLeft + 'px';
            chatBox.style.top = newTop + 'px';
        }

        function chatDrop() {
            chatDragging = false;
            document.removeEventListener('mousemove', chatDrag);
            document.removeEventListener('mouseup', chatDrop);
        }
    </script>

    <footer class="footer-main">
        <div class="container">
            <div class="row g-4 text-start">
                <div class="col-lg-4">
                    <h5 class="text-white"><i class="bi bi-house-heart-fill text-primary me-2"></i> RoomFinder</h5>
                    <p>Giải pháp tìm kiếm phòng trọ hàng đầu dành cho sinh viên.</p>
                </div>
                <div class="col-lg-2">
                    <h5 class="text-white">Menu</h5>
                    <a href="/" class="footer-link">@Localizer["Home"]</a>
                    <a href="/PhongTro/TimKiem" class="footer-link">@Localizer["FindRoom"]</a>
                    <a href="/Home/AboutUs" class="footer-link">Về chúng tôi</a>
                </div>
                <div class="col-lg-3">
                    <h5 class="text-white">Hỗ trợ</h5>
                    <a href="/Home/Terms" class="footer-link">Chính sách bảo mật</a>
                    <a href="/Home/AboutUs" class="footer-link">Hướng dẫn đăng tin</a>
                </div>
                <div class="col-lg-3">
                    <h5 class="text-white">Liên hệ</h5>
                    <p class="small mb-1"><i class="bi bi-geo-alt text-primary me-2"></i> Quận Bình Thạnh, TP.HCM</p>
                    <p class="small"><i class="bi bi-envelope text-primary me-2"></i> hotro@roomfinder.com</p>
                </div>
            </div>
            <hr class="mt-4 border-secondary">
            <div class="text-center small pb-2">
                &copy; @DateTime.Now.Year - Nền tảng hỗ trợ tìm trọ sinh viên
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>