@using Microsoft.AspNetCore.Identity
@using Do_an_co_so.Models

@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

<ul class="navbar-nav d-flex align-items-center">
    @if (SignInManager.IsSignedIn(User))
    {
        var currentUser = await UserManager.GetUserAsync(User);

        <li class="nav-item">
            <a id="manage" class="nav-link text-white fw-bold" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                Hello @currentUser?.HoTen!
            </a>
        </li>
        <li class="nav-item">
            <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button id="logout" type="submit" class="nav-link btn btn-link text-white border-0 fw-bold">Đăng xuất</button>
            </form>
        </li>
        <li class="nav-item">
            <button id="theme-toggle" class="btn btn-warning btn-sm ms-2" type="button" style="display: block !important;">
                <i id="theme-icon" class="bi bi-sun-fill" style="color: black !important;"></i>
                <span style="color: black; font-size: 12px; font-weight: bold;">MODE</span>
            </button>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-white fw-bold" id="register" asp-area="Identity" asp-page="/Account/Register">Đăng ký</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white fw-bold" id="login" asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>
        </li>
    }
</ul>