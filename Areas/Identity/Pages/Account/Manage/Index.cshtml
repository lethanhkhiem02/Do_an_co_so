@page
@model IndexModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<h3 class="text-primary fw-bold mb-4">@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-7">
        <form id="profile-form" method="post" enctype="multipart/form-data" class="card card-custom p-4 shadow-sm border-0 bg-light">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="text-center mb-5">
                @if (!string.IsNullOrEmpty(Model.Input.AvatarUrl))
                {
                    <img src="~/images/avatars/@Model.Input.AvatarUrl" class="rounded-circle shadow border border-3 border-primary" style="width: 150px; height: 150px; object-fit: cover;" alt="Avatar" />
                }
                else
                {
                    <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center mx-auto shadow" style="width: 150px; height: 150px; font-size: 60px;">
                        @(string.IsNullOrEmpty(Model.Input.HoTen) ? "U" : Model.Input.HoTen.Substring(0, 1).ToUpper())
                    </div>
                }
                <div class="mt-3">
                    <label class="form-label fw-bold text-muted">Thay ảnh đại diện</label>
                    <input type="file" asp-for="Input.AvatarFile" class="form-control form-control-sm w-50 mx-auto" accept="image/*" />
                </div>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Username" class="form-control text-muted" disabled />
                <label asp-for="Username" class="form-label">📧 Email / Tài khoản</label>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.HoTen" class="form-control fw-bold" placeholder="Nhập họ và tên" />
                <label asp-for="Input.HoTen" class="form-label">👤 Họ và tên</label>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-floating mb-3">
                        <input asp-for="Input.NgaySinh" class="form-control" />
                        <label asp-for="Input.NgaySinh" class="form-label">🎂 Ngày sinh</label>
                    </div>
                    @if (Model.Input.NgaySinh.HasValue)
                    {
                        var age = DateTime.Now.Year - Model.Input.NgaySinh.Value.Year;
                        if (DateTime.Now.DayOfYear < Model.Input.NgaySinh.Value.DayOfYear) age--;
                        <small class="text-success fw-bold ms-2 mb-3 d-block">👉 Hiện tại bạn @age tuổi</small>
                    }
                </div>
                <div class="col-md-6">
                    <div class="form-floating mb-3">
                        <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Số điện thoại" />
                        <label asp-for="Input.PhoneNumber" class="form-label">📞 Số điện thoại</label>
                    </div>
                </div>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="Input.DiaChi" class="form-control" placeholder="Nhập địa chỉ" />
                <label asp-for="Input.DiaChi" class="form-label">📍 Địa chỉ đang ở</label>
            </div>

            <button id="update-profile-button" type="submit" class="btn btn-lg btn-primary w-100 fw-bold shadow-sm">Lưu thay đổi hồ sơ</button>
        </form>
    </div>

    <div class="col-md-5">
        <div class="card p-4 shadow-sm border-0 bg-white border-top border-warning border-4">
            <h5 class="fw-bold text-dark mb-3">🛡️ Xác Thực Danh Tính (eKYC)</h5>

            <div class="mb-4">
                Trạng thái:
                @if (Model.Input.TrangThaiXacThuc == "Đã duyệt")
                {
                    <span class="badge bg-success fs-6"><i class="bi bi-shield-check"></i> Đã xác thực</span>
                }
                else if (Model.Input.TrangThaiXacThuc == "Chờ duyệt")
                {
                    <span class="badge bg-warning text-dark fs-6"><i class="bi bi-hourglass-split"></i> Đang chờ Admin duyệt</span>
                }
                else
                {
                    <span class="badge bg-secondary fs-6"><i class="bi bi-shield-exclamation"></i> Chưa xác thực</span>
                }
            </div>

            @if (Model.Input.TrangThaiXacThuc == "Chưa xác thực" || string.IsNullOrEmpty(Model.Input.TrangThaiXacThuc))
            {
                <form method="post" enctype="multipart/form-data">
                    <div class="alert alert-info small">
                        Vui lòng tải lên ảnh CCCD mặt trước và mặt sau rõ nét. Hệ thống AI sẽ tự động trích xuất thông tin của bạn.
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Ảnh mặt trước CCCD:</label>
                        <input type="file" asp-for="Input.CCCDTruocFile" class="form-control" accept="image/*" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ảnh mặt sau CCCD:</label>
                        <input type="file" asp-for="Input.CCCDSauFile" class="form-control" accept="image/*" required />
                    </div>

                    <button type="submit" class="btn btn-warning w-100 fw-bold shadow-sm">Gửi Yêu Cầu Xác Thực 🚀</button>
                </form>
            }
            else
            {
                <div class="alert alert-success mt-2">
                    <p class="mb-2"><strong>Ảnh đã tải lên hệ thống:</strong></p>
                    <div class="d-flex gap-2">
                        @if (!string.IsNullOrEmpty(Model.Input.CCCDTruocUrl))
                        {
                            <img src="~/images/cccd/@Model.Input.CCCDTruocUrl" class="img-thumbnail" style="width: 50%; height: 120px; object-fit: cover;" alt="Mặt trước">
                        }
                        @if (!string.IsNullOrEmpty(Model.Input.CCCDSauUrl))
                        {
                            <img src="~/images/cccd/@Model.Input.CCCDSauUrl" class="img-thumbnail" style="width: 50%; height: 120px; object-fit: cover;" alt="Mặt sau">
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Input.SoCCCDQuetDuoc))
                    {
                        <div class="mt-3 p-2 bg-white border border-success rounded text-center">
                            <small class="text-muted d-block">AI đã quét và trích xuất số CCCD:</small>
                            <span class="fw-bold text-success fs-5 tracking-widest">@Model.Input.SoCCCDQuetDuoc</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>