@page
@model LoginModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Do_an_co_so.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["Login"];
    Layout = "/Views/Shared/_Layout.cshtml";
}

<style>
    .auth-card {
        border: none !important;
        border-radius: 20px !important;
        overflow: hidden;
        background-color: #ffffff !important;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .auth-card:hover {
            transform: translateY(-3px);
        }

    .auth-image-col {
        background: linear-gradient(135deg, #0d6efd 0%, #00d2ff 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
        color: #ffffff !important;
    }

    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
        color: #0d6efd !important;
    }

    .form-control:focus {
        border-color: #0d6efd !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1) !important;
    }
</style>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card auth-card shadow-lg border-0">
                <div class="row g-0">

                    <div class="col-md-7">
                        <div class="card-body p-5">
                            <h3 class="card-title text-center text-primary fw-bold mb-4">
                                <i class="bi bi-box-arrow-in-right me-2"></i> @Localizer["WelcomeBack"]
                            </h3>

                            <form id="account" method="post">
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Email" class="form-control rounded-pill px-4" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                                    <label asp-for="Input.Email" class="ms-3 text-muted">@Localizer["LoginEmail"]</label>
                                    <span asp-validation-for="Input.Email" class="text-danger ps-3 small"></span>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Password" class="form-control rounded-pill px-4" autocomplete="current-password" aria-required="true" placeholder="password" />
                                    <label asp-for="Input.Password" class="ms-3 text-muted">@Localizer["Password"]</label>
                                    <span asp-validation-for="Input.Password" class="text-danger ps-3 small"></span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-4 px-2">
                                    <div class="form-check">
                                        <input class="form-check-input" asp-for="Input.RememberMe" />
                                        <label class="form-check-label text-muted" asp-for="Input.RememberMe">
                                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                                        </label>
                                    </div>
                                    <a id="forgot-password" class="text-decoration-none small text-primary fw-bold" asp-page="./ForgotPassword">@Localizer["ForgotPassword"]</a>
                                </div>

                                <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary rounded-pill fw-bold py-3 shadow-sm">@Localizer["Login"]</button>
                            </form>

                            <div class="text-center mt-4 pt-3 border-top">
                                <p class="text-muted mb-2">@Localizer["NewUserPrompt"]</p>
                                <a class="btn btn-outline-primary rounded-pill fw-bold px-4" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">@Localizer["CreateNewAccount"]</a>
                                <div class="mt-3">
                                    <a id="resend-confirmation" class="text-decoration-none small text-muted" asp-page="./ResendEmailConfirmation">@Localizer["ResendConfirmEmail"]</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-5 d-none d-md-flex auth-image-col text-center">
                        <div>
                            <i class="bi bi-person-badge-fill" style="font-size: 8rem; color: rgba(255, 255, 255, 0.9) !important;"></i>
                            <h2 class="fw-bold mt-3 text-white">@Localizer["Hello"]</h2>
                            <p class="mt-3 px-3 text-white" style="opacity: 0.9;">@Localizer["LoginDescription"]</p>

                            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                            {
                                <hr class="border-light opacity-50 my-4 mx-4" />
                                <p class="text-white small">@Localizer["OrLoginWith"]</p>
                                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                    @foreach (var provider in Model.ExternalLogins!)
                                    {
                                        <button type="submit" class="btn btn-light rounded-pill fw-bold text-primary px-4 shadow-sm mb-2" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                                            <i class="bi bi-globe me-1"></i> @provider.DisplayName
                                        </button>
                                    }
                                </form>
                            }
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}