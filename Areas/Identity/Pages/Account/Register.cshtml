@page
@model RegisterModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<style>
    .auth-card {
        border: none !important;
        border-radius: 20px !important;
        overflow: hidden;
        background-color: #ffffff !important;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .auth-card:hover {
            transform: translateY(-3px);
        }

    .auth-image-col {
        background: linear-gradient(135deg, #0d6efd 0%, #00d2ff 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
        color: #ffffff !important;
    }

    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-select:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label,
    .form-floating > .form-select:not(:placeholder-shown) ~ label {
        color: #0d6efd !important;
    }

    .form-control:focus, .form-select:focus {
        border-color: #0d6efd !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1) !important;
    }
</style>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card auth-card shadow-lg border-0">
                <div class="row g-0">

                    <div class="col-md-7">
                        <div class="card-body p-5">
                            <h3 class="card-title text-center text-primary fw-bold mb-4">
                                <i class="bi bi-person-plus-fill me-2"></i> Tạo tài khoản mới
                            </h3>

                            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.HoTen" class="form-control rounded-pill px-4" aria-required="true" placeholder="Nguyễn Văn A" />
                                    <label asp-for="Input.HoTen" class="ms-3 text-muted">Họ và Tên</label>
                                    <span asp-validation-for="Input.HoTen" class="text-danger ps-3 small"></span>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Email" class="form-control rounded-pill px-4" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                                    <label asp-for="Input.Email" class="ms-3 text-muted">Email đăng nhập</label>
                                    <span asp-validation-for="Input.Email" class="text-danger ps-3 small"></span>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-floating mb-3">
                                            <input asp-for="Input.Password" class="form-control rounded-pill px-4" autocomplete="new-password" aria-required="true" placeholder="password" />
                                            <label asp-for="Input.Password" class="ms-3 text-muted">Mật khẩu</label>
                                            <span asp-validation-for="Input.Password" class="text-danger ps-3 small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating mb-3">
                                            <input asp-for="Input.ConfirmPassword" class="form-control rounded-pill px-4" autocomplete="new-password" aria-required="true" placeholder="password" />
                                            <label asp-for="Input.ConfirmPassword" class="ms-3 text-muted">Xác nhận MK</label>
                                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger ps-3 small"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-floating mb-4">
                                    <select asp-for="Input.Role" class="form-select rounded-pill px-4" aria-required="true">
                                        <option value="">-- Chọn loại tài khoản --</option>
                                        <option value="SinhVien">🎓 Sinh Viên (Tìm phòng)</option>
                                        <option value="ChuTro">🔑 Chủ Trọ (Cho thuê phòng)</option>
                                    </select>
                                    <label asp-for="Input.Role" class="ms-3 text-muted">Bạn là ai?</label>
                                    <span asp-validation-for="Input.Role" class="text-danger ps-3 small"></span>
                                </div>

                                <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary rounded-pill fw-bold py-3 shadow-sm">Đăng ký ngay</button>
                            </form>

                            <div class="text-center mt-4">
                                <p class="text-muted mb-0">Đã có tài khoản? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-primary fw-bold text-decoration-none">Đăng nhập</a></p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-5 d-none d-md-flex auth-image-col text-center">
                        <div>
                            <i class="bi bi-rocket-takeoff-fill" style="font-size: 8rem; color: rgba(255, 255, 255, 0.9) !important;"></i>
                            <h2 class="fw-bold mt-3 text-white">Bắt đầu ngay!</h2>
                            <p class="mt-3 px-3 text-white" style="opacity: 0.9;">Tham gia nền tảng để tìm kiếm phòng trọ ưng ý hoặc cho thuê phòng nhanh chóng an toàn.</p>

                            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                            {
                                <hr class="border-light opacity-50 my-4 mx-4" />
                                <p class="text-white small">Hoặc tiếp tục với</p>
                                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                    @foreach (var provider in Model.ExternalLogins!)
                                    {
                                        <button type="submit" class="btn btn-light rounded-pill fw-bold text-primary px-4 shadow-sm mb-2" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">
                                            <i class="bi bi-globe me-1"></i> @provider.DisplayName
                                        </button>
                                    }
                                </form>
                            }
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}